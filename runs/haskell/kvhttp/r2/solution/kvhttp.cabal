cabal-version:      3.0
name:               kvhttp
version:            0.1.0.0
synopsis:           In-memory HTTP/1.1 key-value server
build-type:         Simple

executable kvhttp
    main-is:          Main.hs
    hs-source-dirs:   src
    default-language: GHC2021
    ghc-options:      -O2 -Wall -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:
        base        >=4.18 && <5,
        bytestring  >=0.11 && <0.13,
        containers  >=0.6  && <0.9,
        http-types  >=0.12 && <0.13,
        wai         >=3.2  && <3.3,
        warp        >=3.3  && <3.5
