    {
      "path": "FetchUsers.vue",
      "text": "<script setup>\nimport { ref, onMounted, onUnmounted } from 'vue'\n\nconst users = ref([])\nconst loading = ref(true)\nconst error = ref(null)\nconst controller = new AbortController()\n\nonMounted(async () => {\n  try {\n    const res = await fetch('https://jsonplaceholder.typicode.com/users', { signal: controller.signal })\n    if (!res.ok) throw new Error(`HTTP ${res.status}`)\n    users.value = await res.json()\n  } catch (e) {\n    if (e.name !== 'AbortError') error.value = e\n  } finally {\n    loading.value = false\n  }\n})\n\nonUnmounted(() => controller.abort())\n</script>\n\n<template>\n  <p v-if=\"loading\">Loading…</p>\n  <p v-else-if=\"error\">Error: {{ error.message }}</p>\n  <ul v-else>\n    <li v-for=\"user in users\" :key=\"user.id\">{{ user.name }}</li>\n  </ul>\n</template>\n"
    },
    {
      "path": "FilterTable.vue",
      "text": "<script setup>\nimport { ref, computed } from 'vue'\n\nconst props = defineProps({\n  rows: { type: Array, default: () => [] }\n})\n\nconst columns = ['name', 'price', 'qty']\nconst query = ref('')\nconst sortKey = ref(null)\nconst sortAsc = ref(true)\n\nconst visibleRows = computed(() => {\n  const q = query.value.toLowerCase()\n  const filtered = props.rows.filter(row => row.name.toLowerCase().includes(q))\n  if (!sortKey.value) return filtered\n  const key = sortKey.value\n  const dir = sortAsc.value ? 1 : -1\n  return [...filtered].sort((a, b) => {\n    const x = a[key]\n    const y = b[key]\n    const cmp = typeof x === 'string' ? x.localeCompare(y) : x - y\n    return cmp * dir\n  })\n})\n\nconst total = computed(() =>\n  visibleRows.value.reduce((sum, row) => sum + row.price * row.qty, 0)\n)\n\nfunction sortBy(key) {\n  if (sortKey.value === key) {\n    sortAsc.value = !sortAsc.value\n  } else {\n    sortKey.value = key\n    sortAsc.value = true\n  }\n}\n</script>\n\n<template>\n  <div>\n    <input v-model=\"query\" type=\"search\" placeholder=\"Search\" />\n    <table>\n      <thead>\n        <tr>\n          <th v-for=\"col in columns\" :key=\"col\" @click=\"sortBy(col)\">\n            {{ col }}{{ sortKey === col ? (sortAsc ? ' ▲' : ' ▼') : '' }}\n          </th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr v-for=\"(row, i) in visibleRows\" :key=\"`${row.name}-${i}`\">\n          <td>{{ row.name }}</td>\n          <td>{{ row.price }}</td>\n          <td>{{ row.qty }}</td>\n        </tr>\n      </tbody>\n      <tfoot>\n        <tr>\n          <td colspan=\"2\">Total</td>\n          <td>{{ total }}</td>\n        </tr>\n      </tfoot>\n    </table>\n  </div>\n</template>\n"
    },
    {
      "path": "Hello.vue",
      "text": "<script setup>\ndefineProps({\n  name: { type: String, required: true }\n})\n</script>\n\n<template>\n  <p>Hello, {{ name }}!</p>\n</template>\n"
    },
    {
      "path": "KvBrowser.vue",
      "text": "<script setup>\nimport { ref, onMounted } from 'vue'\n\nconst props = defineProps({\n  baseUrl: { type: String, required: true }\n})\n\nconst keys = ref([])\nconst selectedKey = ref(null)\nconst selectedValue = ref('')\nconst newKey = ref('')\nconst newValue = ref('')\nconst error = ref(null)\n\nconst url = key => `${props.baseUrl}/kv${key === undefined ? '' : `/${encodeURIComponent(key)}`}`\n\nasync function request(key, options) {\n  const res = await fetch(url(key), options)\n  if (!res.ok) throw new Error(`HTTP ${res.status}`)\n  return res\n}\n\nasync function run(action) {\n  try {\n    error.value = null\n    await action()\n  } catch (e) {\n    error.value = e.message\n  }\n}\n\nconst loadKeys = () => run(async () => {\n  keys.value = await (await request()).json()\n})\n\nconst showValue = key => run(async () => {\n  selectedValue.value = await (await request(key)).text()\n  selectedKey.value = key\n})\n\nconst save = () => run(async () => {\n  if (!newKey.value) return\n  await request(newKey.value, { method: 'PUT', body: newValue.value })\n  if (selectedKey.value === newKey.value) selectedValue.value = newValue.value\n  newKey.value = ''\n  newValue.value = ''\n  await loadKeys()\n})\n\nconst remove = key => run(async () => {\n  await request(key, { method: 'DELETE' })\n  if (selectedKey.value === key) selectedKey.value = null\n  await loadKeys()\n})\n\nonMounted(loadKeys)\n</script>\n\n<template>\n  <div>\n    <p v-if=\"error\">Error: {{ error }}</p>\n    <form @submit.prevent=\"save\">\n      <input v-model=\"newKey\" placeholder=\"Key\" />\n      <input v-model=\"newValue\" placeholder=\"Value\" />\n      <button type=\"submit\">Save</button>\n    </form>\n    <ul>\n      <li v-for=\"key in keys\" :key=\"key\">\n        <button type=\"button\" @click=\"showValue(key)\">{{ key }}</button>\n        <button type=\"button\" @click=\"remove(key)\">Delete</button>\n      </li>\n    </ul>\n    <div v-if=\"selectedKey !== null\">\n      <h3>{{ selectedKey }}</h3>\n      <pre>{{ selectedValue }}</pre>\n    </div>\n  </div>\n</template>\n"
    },
    {
      "path": "Todo.vue",
      "text": "<script setup>\nimport { ref } from 'vue'\n\nconst text = ref('')\nconst items = ref([])\nlet nextId = 0\n\nfunction add() {\n  const value = text.value.trim()\n  if (!value) return\n  items.value.push({ id: nextId++, text: value })\n  text.value = ''\n}\n\nfunction remove(id) {\n  items.value = items.value.filter(item => item.id !== id)\n}\n</script>\n\n<template>\n  <div>\n    <form @submit.prevent=\"add\">\n      <input v-model=\"text\" />\n      <button type=\"submit\">Add</button>\n    </form>\n    <ul>\n      <li v-for=\"item in items\" :key=\"item.id\">\n        {{ item.text }}\n        <button type=\"button\" @click=\"remove(item.id)\">Remove</button>\n      </li>\n    </ul>\n  </div>\n</template>\n"
    }
  ]
}
