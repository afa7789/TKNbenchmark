    {
      "path": "FetchUsers.svelte",
      "text": "<script>\n  import { onMount } from 'svelte';\n\n  let users = $state([]);\n  let loading = $state(true);\n  let error = $state(null);\n\n  onMount(() => {\n    const controller = new AbortController();\n    (async () => {\n      try {\n        const res = await fetch('https://jsonplaceholder.typicode.com/users', {\n          signal: controller.signal\n        });\n        if (!res.ok) throw new Error(`HTTP ${res.status}`);\n        users = await res.json();\n      } catch (e) {\n        if (e.name !== 'AbortError') error = e.message;\n      } finally {\n        loading = false;\n      }\n    })();\n    return () => controller.abort();\n  });\n</script>\n\n{#if loading}\n  <p>Loading…</p>\n{:else if error}\n  <p>Error: {error}</p>\n{:else}\n  <ul>\n    {#each users as user (user.id)}\n      <li>{user.name}</li>\n    {/each}\n  </ul>\n{/if}\n"
    },
    {
      "path": "FilterTable.svelte",
      "text": "<script>\n  let { rows = [] } = $props();\n\n  const columns = ['name', 'price', 'qty'];\n\n  let query = $state('');\n  let sortKey = $state(null);\n  let ascending = $state(true);\n\n  let visible = $derived.by(() => {\n    const q = query.toLowerCase();\n    const filtered = rows.filter((row) => row.name.toLowerCase().includes(q));\n    if (!sortKey) return filtered;\n    const dir = ascending ? 1 : -1;\n    return filtered.toSorted((a, b) => {\n      const x = a[sortKey];\n      const y = b[sortKey];\n      if (typeof x === 'string') return x.localeCompare(y) * dir;\n      return (x - y) * dir;\n    });\n  });\n\n  let total = $derived(visible.reduce((sum, row) => sum + row.price * row.qty, 0));\n\n  function sortBy(key) {\n    if (sortKey === key) {\n      ascending = !ascending;\n    } else {\n      sortKey = key;\n      ascending = true;\n    }\n  }\n</script>\n\n<input type=\"search\" placeholder=\"Search\" bind:value={query} />\n<table>\n  <thead>\n    <tr>\n      {#each columns as column}\n        <th onclick={() => sortBy(column)}>\n          {column}{sortKey === column ? (ascending ? ' ▲' : ' ▼') : ''}\n        </th>\n      {/each}\n    </tr>\n  </thead>\n  <tbody>\n    {#each visible as row, i (row.name + i)}\n      <tr>\n        <td>{row.name}</td>\n        <td>{row.price}</td>\n        <td>{row.qty}</td>\n      </tr>\n    {/each}\n  </tbody>\n  <tfoot>\n    <tr>\n      <td colspan=\"2\">Total</td>\n      <td>{total}</td>\n    </tr>\n  </tfoot>\n</table>\n"
    },
    {
      "path": "Hello.svelte",
      "text": "<script>\n  let { name } = $props();\n</script>\n\n<p>Hello, {name}!</p>\n"
    },
    {
      "path": "KvBrowser.svelte",
      "text": "<script>\n  let { baseUrl } = $props();\n\n  let keys = $state([]);\n  let selected = $state(null);\n  let value = $state('');\n  let newKey = $state('');\n  let newValue = $state('');\n  let error = $state(null);\n\n  const url = (key) => `${baseUrl}/kv${key === undefined ? '' : `/${encodeURIComponent(key)}`}`;\n\n  async function request(path, options) {\n    const res = await fetch(path, options);\n    if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);\n    return res;\n  }\n\n  async function run(action) {\n    error = null;\n    try {\n      await action();\n    } catch (e) {\n      error = e.message;\n    }\n  }\n\n  const load = () =>\n    run(async () => {\n      keys = await (await request(url())).json();\n    });\n\n  const show = (key) =>\n    run(async () => {\n      value = await (await request(url(key))).text();\n      selected = key;\n    });\n\n  function save(event) {\n    event.preventDefault();\n    if (!newKey) return;\n    run(async () => {\n      await request(url(newKey), { method: 'PUT', body: newValue });\n      if (selected === newKey) value = newValue;\n      newKey = '';\n      newValue = '';\n      await load();\n    });\n  }\n\n  const remove = (key) =>\n    run(async () => {\n      await request(url(key), { method: 'DELETE' });\n      if (selected === key) selected = null;\n      await load();\n    });\n\n  $effect(() => {\n    baseUrl;\n    selected = null;\n    load();\n  });\n</script>\n\n{#if error}\n  <p role=\"alert\">Error: {error}</p>\n{/if}\n\n<form onsubmit={save}>\n  <input placeholder=\"Key\" bind:value={newKey} />\n  <input placeholder=\"Value\" bind:value={newValue} />\n  <button type=\"submit\">Save</button>\n</form>\n\n<ul>\n  {#each keys as key (key)}\n    <li>\n      <button onclick={() => show(key)}>{key}</button>\n      <button onclick={() => remove(key)}>Delete</button>\n    </li>\n  {/each}\n</ul>\n\n{#if selected !== null}\n  <h2>{selected}</h2>\n  <pre>{value}</pre>\n{/if}\n"
    },
    {
      "path": "Todo.svelte",
      "text": "<script>\n  let text = $state('');\n  let items = $state([]);\n  let nextId = 0;\n\n  function add(event) {\n    event.preventDefault();\n    const value = text.trim();\n    if (!value) return;\n    items.push({ id: nextId++, text: value });\n    text = '';\n  }\n\n  function remove(id) {\n    items = items.filter((item) => item.id !== id);\n  }\n</script>\n\n<form onsubmit={add}>\n  <input bind:value={text} />\n  <button type=\"submit\">Add</button>\n</form>\n<ul>\n  {#each items as item (item.id)}\n    <li>\n      {item.text}\n      <button onclick={() => remove(item.id)}>Remove</button>\n    </li>\n  {/each}\n</ul>\n"
    }
  ]
}
