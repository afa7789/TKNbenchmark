{
  "id": "vue-shop-r1",
  "files": [
    {
      "path": "App.vue",
      "text": "<script setup>\nimport { ref, provide } from 'vue'\nimport Header from './Header.vue'\nimport ProductList from './ProductList.vue'\nimport Cart from './Cart.vue'\nimport Modal from './Modal.vue'\nimport CheckoutForm from './CheckoutForm.vue'\n\ndefineProps({\n  products: { type: Array, required: true }\n})\n\nprovide('currency', 'USD')\n\nconst checkoutOpen = ref(false)\n</script>\n\n<template>\n  <Header @checkout=\"checkoutOpen = true\" />\n  <ProductList :products=\"products\" />\n  <Cart />\n  <Modal v-if=\"checkoutOpen\" @close=\"checkoutOpen = false\">\n    <CheckoutForm @submitted=\"checkoutOpen = false\" />\n  </Modal>\n</template>\n"
    },
    {
      "path": "Cart.vue",
      "text": "<script setup>\nimport { computed, inject } from 'vue'\nimport { useCart } from './useCart.js'\n\nconst { state, remove, setQuantity } = useCart()\nconst currency = inject('currency')\n\nconst formatter = computed(() => new Intl.NumberFormat(undefined, { style: 'currency', currency }))\nconst subtotal = computed(() => state.items.reduce((sum, item) => sum + item.price * item.quantity, 0))\nconst tax = computed(() => subtotal.value * 0.1)\nconst total = computed(() => subtotal.value + tax.value)\n</script>\n\n<template>\n  <section>\n    <h2>Cart</h2>\n    <ul>\n      <li v-for=\"item in state.items\" :key=\"item.id\">\n        <span>{{ item.name }}</span>\n        <input\n          v-model.number=\"item.quantity\"\n          type=\"number\"\n          min=\"1\"\n          @change=\"setQuantity(item.id, item.quantity)\"\n        />\n        <span>{{ formatter.format(item.price * item.quantity) }}</span>\n        <button type=\"button\" @click=\"remove(item.id)\">Remove</button>\n      </li>\n    </ul>\n    <p>Subtotal: {{ formatter.format(subtotal) }}</p>\n    <p>Tax: {{ formatter.format(tax) }}</p>\n    <p>Total: {{ formatter.format(total) }}</p>\n  </section>\n</template>\n"
    },
    {
      "path": "CheckoutForm.vue",
      "text": "<script setup>\nimport { ref, computed } from 'vue'\nimport { useCart } from './useCart.js'\n\nconst emit = defineEmits(['submitted'])\nconst { clear } = useCart()\n\nconst name = ref('')\nconst email = ref('')\n\nconst nameError = computed(() => (name.value.trim() ? '' : 'Name is required'))\nconst emailError = computed(() => (email.value.includes('@') ? '' : 'Email must contain @'))\nconst isValid = computed(() => !nameError.value && !emailError.value)\n\nfunction submit() {\n  if (!isValid.value) return\n  clear()\n  emit('submitted')\n}\n</script>\n\n<template>\n  <form @submit.prevent=\"submit\">\n    <label>\n      Name\n      <input v-model=\"name\" type=\"text\" />\n    </label>\n    <p v-if=\"nameError\">{{ nameError }}</p>\n    <label>\n      Email\n      <input v-model=\"email\" type=\"email\" />\n    </label>\n    <p v-if=\"emailError\">{{ emailError }}</p>\n    <button type=\"submit\" :disabled=\"!isValid\">Place order</button>\n  </form>\n</template>\n"
    },
    {
      "path": "Header.vue",
      "text": "<script setup>\nimport { useCart } from './useCart.js'\n\nconst emit = defineEmits(['checkout'])\nconst { count } = useCart()\n</script>\n\n<template>\n  <header>\n    <span>Cart: {{ count }}</span>\n    <button type=\"button\" @click=\"emit('checkout')\">Checkout</button>\n  </header>\n</template>\n"
    },
    {
      "path": "Modal.vue",
      "text": "<script setup>\nimport { onMounted, onUnmounted } from 'vue'\n\nconst emit = defineEmits(['close'])\n\nfunction onKeydown(event) {\n  if (event.key === 'Escape') emit('close')\n}\n\nonMounted(() => document.addEventListener('keydown', onKeydown))\nonUnmounted(() => document.removeEventListener('keydown', onKeydown))\n</script>\n\n<template>\n  <div role=\"dialog\" aria-modal=\"true\">\n    <button type=\"button\" aria-label=\"Close\" @click=\"emit('close')\">×</button>\n    <slot />\n  </div>\n</template>\n"
    },
    {
      "path": "ProductItem.vue",
      "text": "<script setup>\nimport { inject } from 'vue'\n\nconst props = defineProps({\n  product: { type: Object, required: true }\n})\n\nconst emit = defineEmits(['add'])\nconst currency = inject('currency')\n\nconst format = (value) => new Intl.NumberFormat(undefined, { style: 'currency', currency }).format(value)\n</script>\n\n<template>\n  <li>\n    <span>{{ product.name }}</span>\n    <span>{{ format(product.price) }}</span>\n    <button type=\"button\" @click=\"emit('add', props.product)\">Add</button>\n  </li>\n</template>\n"
    },
    {
      "path": "ProductList.vue",
      "text": "<script setup>\nimport { ref, computed } from 'vue'\nimport SearchBox from './SearchBox.vue'\nimport ProductItem from './ProductItem.vue'\nimport { useCart } from './useCart.js'\n\nconst props = defineProps({\n  products: { type: Array, required: true }\n})\n\nconst { add } = useCart()\nconst query = ref('')\nconst category = ref('')\n\nconst categories = computed(() => [...new Set(props.products.map((p) => p.category))])\n\nconst filtered = computed(() => {\n  const q = query.value.trim().toLowerCase()\n  return props.products.filter(\n    (p) =>\n      (!category.value || p.category === category.value) &&\n      (!q || p.name.toLowerCase().includes(q))\n  )\n})\n</script>\n\n<template>\n  <section>\n    <SearchBox @search=\"query = $event\" />\n    <select v-model=\"category\">\n      <option value=\"\">All categories</option>\n      <option v-for=\"c in categories\" :key=\"c\" :value=\"c\">{{ c }}</option>\n    </select>\n    <ul v-if=\"filtered.length\">\n      <ProductItem v-for=\"product in filtered\" :key=\"product.id\" :product=\"product\" @add=\"add\" />\n    </ul>\n    <p v-else>No products</p>\n  </section>\n</template>\n"
    },
    {
      "path": "SearchBox.vue",
      "text": "<script setup>\nimport { ref, onUnmounted } from 'vue'\n\nconst emit = defineEmits(['search'])\nconst query = ref('')\nlet timer = null\n\nfunction onInput() {\n  clearTimeout(timer)\n  timer = setTimeout(() => {\n    timer = null\n    emit('search', query.value)\n  }, 300)\n}\n\nonUnmounted(() => clearTimeout(timer))\n</script>\n\n<template>\n  <input v-model=\"query\" type=\"search\" placeholder=\"Search\" @input=\"onInput\" />\n</template>\n"
    },
    {
      "path": "useCart.js",
      "text": "import { reactive, computed } from 'vue'\n\nconst state = reactive({ items: [] })\n\nconst count = computed(() => state.items.reduce((sum, item) => sum + item.quantity, 0))\n\nfunction add(product) {\n  const existing = state.items.find((item) => item.id === product.id)\n  if (existing) existing.quantity++\n  else state.items.push({ ...product, quantity: 1 })\n}\n\nfunction remove(id) {\n  state.items = state.items.filter((item) => item.id !== id)\n}\n\nfunction setQuantity(id, quantity) {\n  const n = Math.floor(Number(quantity))\n  if (!Number.isFinite(n) || n <= 0) return remove(id)\n  const item = state.items.find((item) => item.id === id)\n  if (item) item.quantity = n\n}\n\nfunction clear() {\n  state.items = []\n}\n\nexport function useCart() {\n  return { state, count, add, remove, setQuantity, clear }\n}\n"
    }
  ]
}
