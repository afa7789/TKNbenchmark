      "text": "<script setup>\nimport { ref } from 'vue'\n\nconst count = ref(0)\n</script>\n\n<template>\n  <p>{{ count }}</p>\n  <button type=\"button\" @click=\"count++\">Increment</button>\n</template>\n"
